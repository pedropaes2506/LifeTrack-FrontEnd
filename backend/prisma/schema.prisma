// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------
// --- Enums (Baseado nas suas colunas ENUM e CHECK)
// -------------------------------------------------

// Enum para tb_usuario.sexo_usuario
enum SexoUsuario {
  M
  F
  O
}

// Enum para tb_rotina.tipo_unidade (baseado no CHECK)
enum TipoUnidade {
  ML
  HORAS
  MINUTOS
  UNIDADE
  PASSOS
}

// -------------------------------------------------
// --- Modelos (Baseado nas suas tabelas)
// -------------------------------------------------

// 1. Tabela de Usuários (Quem são)
model User {
  id             Int      @id @default(autoincrement()) @map("id_usuario")
  nome           String   @map("nome_usuario") @db.VarChar(150)
  email          String   @unique @map("email_usuario") @db.VarChar(255)
  senha          String   @map("senha_usuario") @db.VarChar(255)
  cpf            String   @unique @map("cpf_usuario") @db.Char(11)
  sexo           SexoUsuario? @map("sexo_usuario")
  dataNascimento DateTime @map("data_nasc_usuario") @db.Date
  dataCriacao    DateTime @default(now()) @map("data_criacao") @db.DateTime(0)

  // Relacionamento: Um usuário pode ter várias adesões a rotinas
  adesoes Adesao[]

  @@map("tb_usuario")
}

// 2. Tabela de Rotinas (O que pode ser feito)
model Rotina {
  id              Int      @id @default(autoincrement()) @map("id_rotina")
  nome            String   @unique @map("nome_rotina") @db.VarChar(100)
  metaValorPadrao Int?     @map("meta_valor_padrao")
  ativa           Boolean  @default(true)
  dataCriacao     DateTime @default(now()) @map("data_criacao") @db.DateTime(0)
  dataModificacao DateTime @default(now()) @updatedAt @map("data_modificacao") @db.DateTime(0)
  tipoUnidade     TipoUnidade @map("tipo_unidade")

  // Relacionamento: Uma rotina pode ter várias adesões de usuários
  adesoes Adesao[]

  @@map("tb_rotina")
}

// 3. Tabela de Adesão (A ligação entre Usuário e Rotina, com a META)
model Adesao {
  id               Int      @id @default(autoincrement()) @map("id_adesao")
  usuarioId        Int      @map("usuario_id")
  rotinaId         Int      @map("rotina_id")
  metaPessoalValor Float    @map("meta_pessoal_valor") // DOUBLE do MySQL vira Float no Prisma
  dataAdesao       DateTime @default(now()) @map("data_adesao") @db.DateTime(0)
  statusAdesao     Boolean  @default(true) @map("status_adesao")

  // Relacionamento: A quem pertence esta adesão
  // Nota: O seu SQL tinha "REFERENCES tb_usuario(id)", mas o ID em tb_usuario é "id_usuario".
  // O Prisma gerencia isso corretamente através do mapeamento do campo "id" abaixo.
  usuario User @relation(fields: [usuarioId], references: [id])

  // Relacionamento: A qual rotina esta adesão se refere
  rotina  Rotina @relation(fields: [rotinaId], references: [id])

  // Relacionamento: Esta adesão terá vários registros
  registros RegistroRotina[]
  // Relacionamento: Esta adesão tem um streak (1-para-1)
  streak    Streak?

  // Garante que um usuário só pode aderir a uma rotina uma única vez
  @@unique([usuarioId, rotinaId])
  @@map("tb_adesao")
}

// 4. Tabela de Registros (Onde o CUMPRIMENTO da meta é salvo)
model RegistroRotina {
  id            Int      @id @default(autoincrement()) @map("id_registro")
  adesaoId      Int      @map("adesao_id")
  valorRegistro Float    @map("valor_registro") // DOUBLE vira Float
  dataRegistro  DateTime @default(now()) @map("data_registro") @db.DateTime(0)
  metaCumprida  Boolean? @map("meta_cumprida")

  // Relacionamento: Este registro pertence a uma adesão
  adesao Adesao @relation(fields: [adesaoId], references: [id])

  @@map("tb_registro_rotina")
}

// 5. Tabela de Streaks (Contagem de dias consecutivos)
model Streak {
  id                    Int      @id @default(autoincrement()) @map("id_streak")
  adesaoId              Int      @unique @map("adesao_id") // UNIQUE define a relação 1-para-1
  contagemAtual         Int      @default(0) @map("contagem_atual")
  dataInicioStreak      DateTime @map("data_inicio_streak") @db.Date
  dataUltimoCumprimento DateTime @map("data_ultimo_cumprimento") @db.Date
  dataModificacao       DateTime @default(now()) @updatedAt @map("data_modificacao") @db.DateTime(0)

  // Relacionamento: Este streak pertence a uma adesão
  adesao Adesao @relation(fields: [adesaoId], references: [id])

  @@map("tb_streak")
}
